# ─────────────────────────────────────────────────────────────────────────────
# Sabaky environment configuration.
# Copy to `.env` for local development. NEVER commit real secrets.
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser — never put
# secrets in NEXT_PUBLIC_ variables.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://sabaky:sabaky_dev_password@localhost:5432/sabaky?schema=public
# Pool size per instance (set to 1 when using the single-connection "npx prisma dev" database)
DATABASE_POOL_MAX=10

# ── Security ────────────────────────────────────────────────────────────────
# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
# Used to HMAC IP addresses / identifiers in logs (pseudonymisation) and sign tokens.
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Optional 32-byte base64 key for application-level field encryption (AES-256-GCM).
DATA_ENCRYPTION_KEY=
SESSION_TTL_DAYS=30

# ── Payments ────────────────────────────────────────────────────────────────
# "mock" (default, no real money moves) | "stripe"
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Email ───────────────────────────────────────────────────────────────────
# "console" (logs emails to the server console) | "resend" (add adapters for SES, Postmark…)
EMAIL_PROVIDER=console
EMAIL_FROM="Sabaky <no-reply@sabaky.example>"
RESEND_API_KEY=

# ── Object storage (product images, seller documents) ───────────────────────
# "local" (./storage, dev only) | "s3" (any S3-compatible: AWS, R2, MinIO…)
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=eu-west-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public CDN origin in front of the bucket (e.g. https://cdn.sabaky.com)
NEXT_PUBLIC_CDN_URL=

# ── Rate limiting / cache ───────────────────────────────────────────────────
# "memory" (single instance) | "redis"
RATE_LIMIT_STORE=memory
REDIS_URL=

# ── Shipping / carriers ─────────────────────────────────────────────────────
SHIPPING_PROVIDER=mock
